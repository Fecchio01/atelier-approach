generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum LeadStage {
  NEW
  CONTACTED
  INTEREST
  FOLLOW_UP
  WON
  NO_RESPONSE
  DISCARDED
}

enum Channel {
  WHATSAPP
  PHONE
  EMAIL
  INSTAGRAM
  IN_PERSON
  OTHER
}

enum FollowUpState {
  PENDING
  COMPLETED
  CANCELLED
}

enum ActivityType {
  CONTACT
  STAGE_CHANGE
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_COMPLETED
  FOLLOW_UP_CANCELLED
  SALE_WON
  LEAD_REOPENED
  DISCARDED
}

model Lead {
  id        String     @id @default(cuid())
  osmId     String     @unique
  name      String?
  phone     String?
  website   String?
  instagram String?
  whatsapp  String?
  address   String?
  category  String?
  latitude  Float?
  longitude Float?
  syncedAt  DateTime?
  stage     LeadStage  @default(NEW)
  saleValue Decimal?
  mrr       Decimal?
  wonAt     DateTime?
  wonById   String?
  activities Activity[]
  followUps  FollowUp[]
  stageHistory StageHistory[]
  saleEvents SaleEvent[]
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  actorId   String
  type      ActivityType @default(CONTACT)
  channel   Channel?
  note      String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([actorId])
}

model StageHistory {
  id        String    @id @default(cuid())
  leadId    String
  actorId   String
  fromStage LeadStage?
  toStage   LeadStage
  createdAt DateTime  @default(now())
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model SaleEvent {
  id        String   @id @default(cuid())
  leadId    String
  actorId   String
  saleValue Decimal
  mrr       Decimal
  occurredAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, occurredAt])
  @@index([occurredAt])
}

model FollowUp {
  id        String        @id @default(cuid())
  leadId    String
  dueDate   DateTime
  ownerId   String
  state     FollowUpState @default(PENDING)
  note      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  completedAt DateTime?
  completedById String?
  cancelledAt DateTime?
  cancelledById String?
  lead      Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([ownerId, dueDate])
}

model Goal {
  id                String   @id @default(cuid())
  ownerId           String
  weekStart         DateTime
  approachesTarget  Int
  interestsTarget   Int      @default(0)
  meetingsTarget    Int      @default(0)
  salesTarget       Int      @default(0)
  revenueTarget     Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([ownerId, weekStart])
  @@index([weekStart])
}

model MemberProfile {
  id        String   @id
  name      String
  email     String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
