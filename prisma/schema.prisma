generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStage {
  NEW
  CONTACTED
  IN_CONVERSATION
  QUALIFIED
  PROPOSAL
  MEETING
  INTEREST
  FOLLOW_UP
  WON
  NO_RESPONSE
  DISCARDED
}

enum Channel {
  WHATSAPP
  PHONE
  EMAIL
  INSTAGRAM
  IN_PERSON
  OTHER
}

enum FollowUpState {
  PENDING
  COMPLETED
  CANCELLED
}

enum ActivityType {
  CONTACT
  STAGE_CHANGE
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_COMPLETED
  FOLLOW_UP_CANCELLED
  SALE_WON
  SALE_FINANCIALS_UPDATED
  LEAD_REOPENED
  SALE_REVERSED
  DISCARDED
}

enum GoalPeriodKind {
  WEEKLY
  MONTHLY
}

enum ServiceBillingType {
  ONE_TIME
  MONTHLY
}

model Lead {
  id             String         @id @default(cuid())
  osmId          String         @unique
  name           String?
  phone          String?
  website        String?
  instagram      String?
  whatsapp       String?
  address        String?
  category       String?
  latitude       Float?
  longitude      Float?
  syncedAt       DateTime?
  stage          LeadStage      @default(CONTACTED)
  stageEnteredAt DateTime       @default(now())
  postFollowUpAt DateTime?
  discardedAt    DateTime?
  saleValue      Decimal?
  mrr            Decimal?
  wonAt          DateTime?
  wonById        String?
  activities     Activity[]
  followUps      FollowUp[]
  stageHistory   StageHistory[]
  saleEvents     SaleEvent[]

  @@index([stage, stageEnteredAt])
  @@index([discardedAt])
  @@index([postFollowUpAt, id])
}

model Activity {
  id        String       @id @default(cuid())
  leadId    String
  actorId   String
  type      ActivityType @default(CONTACT)
  channel   Channel?
  note      String
  createdAt DateTime     @default(now())
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([actorId])
}

model StageHistory {
  id        String     @id @default(cuid())
  leadId    String
  actorId   String
  fromStage LeadStage?
  toStage   LeadStage
  createdAt DateTime   @default(now())
  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model SaleEvent {
  id           String         @id @default(cuid())
  leadId       String
  actorId      String
  saleValue    Decimal
  mrr          Decimal
  occurredAt   DateTime       @default(now())
  reversedAt   DateTime?
  reversedById String?
  lineItems    SaleLineItem[]
  lead         Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, occurredAt])
  @@index([occurredAt])
  @@index([reversedAt, occurredAt])
}

model ServiceCatalogItem {
  id          String             @id @default(cuid())
  name        String
  price       Decimal            @db.Decimal(12, 2)
  billingType ServiceBillingType
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  saleItems   SaleLineItem[]

  @@index([isActive, name])
}

model SaleLineItem {
  id          String              @id @default(cuid())
  saleEventId String
  serviceId   String?
  serviceName String
  price       Decimal             @db.Decimal(12, 2)
  billingType ServiceBillingType
  saleEvent   SaleEvent           @relation(fields: [saleEventId], references: [id], onDelete: Cascade)
  service     ServiceCatalogItem? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([saleEventId])
  @@index([serviceId])
}

model CrmSettings {
  id                String   @id @default("team")
  followUpDelayDays Int      @default(2)
  updatedAt         DateTime @updatedAt
}

model FollowUp {
  id            String        @id @default(cuid())
  leadId        String
  dueDate       DateTime
  ownerId       String
  state         FollowUpState @default(PENDING)
  note          String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  completedAt   DateTime?
  completedById String?
  cancelledAt   DateTime?
  cancelledById String?
  returnStage   LeadStage?
  lead          Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([ownerId, dueDate])
  @@index([leadId, state, completedAt, id])
}

model Goal {
  id                       String         @id @default(cuid())
  ownerId                  String
  periodKind               GoalPeriodKind
  periodStart              DateTime
  periodEnd                DateTime
  approachesTarget         Int?
  interestsTarget          Int?
  meetingsTarget           Int?
  salesTarget              Int?
  revenueTarget            Float?
  mrrTarget                Float?
  followUpsCompletedTarget Int?
  conversionRateTarget     Float?
  customGoals              Json           @default("[]")
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@unique([ownerId, periodKind, periodStart])
  @@index([periodStart])
}

model TeamGoalSettings {
  id              String   @id @default("team")
  monthlyStartDay Int      @default(1)
  updatedAt       DateTime @updatedAt
}

model DailyReport {
  id         String   @id @default(cuid())
  dayStart   DateTime @unique
  dayEnd     DateTime
  closedAt   DateTime
  closedById String
  snapshot   Json
}

model MetricImportBatch {
  id          String            @id @default(cuid())
  ownerId     String
  actorId     String
  fileName    String
  contentHash String
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime          @default(now())
  rows        MetricImportRow[]

  @@unique([ownerId, contentHash, periodStart, periodEnd])
  @@index([ownerId, periodStart, periodEnd])
  @@index([createdAt])
}

model MetricImportRow {
  id           String            @id @default(cuid())
  batchId      String
  metricKey    String?
  customGoalId String?
  label        String
  unit         String?
  value        Decimal           @db.Decimal(14, 4)
  batch        MetricImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([metricKey])
  @@index([customGoalId])
}

model MemberProfile {
  id         String            @id
  name       String
  email      String
  avatarUrl  String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  credential MemberCredential?
}

model MemberCredential {
  id           String        @id @default(cuid())
  memberId     String        @unique
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  member       MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model ResearchSearchSession {
  id        String   @id
  ownerId   String
  state     Json
  expiresAt DateTime
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, expiresAt])
}
