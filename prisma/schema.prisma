generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStage {
  NEW
  CONTACTED
  IN_CONVERSATION
  QUALIFIED
  PROPOSAL
  MEETING
  INTEREST
  FOLLOW_UP
  WON
  NO_RESPONSE
  DISCARDED
}

enum Channel {
  WHATSAPP
  PHONE
  EMAIL
  INSTAGRAM
  IN_PERSON
  OTHER
}

enum FollowUpState {
  PENDING
  COMPLETED
  CANCELLED
}

enum CrmTaskType {
  WHATSAPP
  PHONE
  EMAIL
  MEETING_PREP
  OTHER
}

enum CrmTaskPriority {
  LOW
  NORMAL
  HIGH
}

enum CrmTaskState {
  PENDING
  COMPLETED
  CANCELLED
}

enum CrmSavedViewScope {
  FUNNEL
  ACTIONS
}

enum ActivityType {
  CONTACT
  STAGE_CHANGE
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_COMPLETED
  FOLLOW_UP_CANCELLED
  SALE_WON
  SALE_FINANCIALS_UPDATED
  LEAD_REOPENED
  SALE_REVERSED
  DISCARDED
  CRM_TASK_CREATED
  CRM_TASK_UPDATED
  CRM_TASK_COMPLETED
  CRM_TASK_CANCELLED
}

enum ActivityOrigin {
  HUMAN
  AGENT
  SYSTEM
}

enum GoalPeriodKind {
  WEEKLY
  MONTHLY
}

enum ServiceBillingType {
  ONE_TIME
  MONTHLY
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  NEEDS_APPROVAL
  COMPLETED
  FAILED
}

enum AgentActionStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
  STALE
}

enum AgentOutboxStatus {
  PENDING
  DELIVERED
}

enum MessagingDirection {
  OUTBOUND
  INBOUND
}

enum MessagingStatus {
  DRAFT
  APPROVED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  UNKNOWN
  BLOCKED
  CANCELLED
}

enum ResearchCampaignStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProspectCandidateStatus {
  NEW
  REVIEW_IDENTITY
  APPROVED
  REJECTED
  PROMOTED
}

model Lead {
  id                          String             @id @default(cuid())
  version                     Int                @default(1)
  osmId                       String             @unique
  name                        String?
  phone                       String?
  website                     String?
  instagram                   String?
  whatsapp                    String?
  address                     String?
  category                    String?
  latitude                    Float?
  longitude                   Float?
  syncedAt                    DateTime?
  stage                       LeadStage          @default(CONTACTED)
  stageEnteredAt              DateTime           @default(now())
  meetingAt                   DateTime?
  lastMeaningfulInteractionAt DateTime?
  postFollowUpAt              DateTime?
  discardedAt                 DateTime?
  saleValue                   Decimal?
  mrr                         Decimal?
  wonAt                       DateTime?
  wonById                     String?
  activities                  Activity[]
  followUps                   FollowUp[]
  crmTasks                    CrmTask[]
  stageHistory                StageHistory[]
  saleEvents                  SaleEvent[]
  agentRuns                   AgentRun[]
  agentActions                AgentAction[]
  prospectCandidate           ProspectCandidate?
  commercialAnalyses          CompanyAnalysis[]
  messages                    MessagingMessage[]

  @@index([stage, stageEnteredAt])
  @@index([stage, stageEnteredAt, id], map: "Lead_stage_stageEnteredAt_id_idx")
  @@index([discardedAt])
  @@index([postFollowUpAt, id])
  @@index([postFollowUpAt, stage, id], map: "Lead_postFollowUpAt_stage_id_idx")
}

model Activity {
  id        String         @id @default(cuid())
  leadId    String
  actorId   String
  type      ActivityType   @default(CONTACT)
  origin    ActivityOrigin @default(HUMAN)
  channel   Channel?
  note      String
  effectKey String?        @unique
  createdAt DateTime       @default(now())
  lead      Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([actorId])
}

model StageHistory {
  id        String     @id @default(cuid())
  leadId    String
  actorId   String
  fromStage LeadStage?
  toStage   LeadStage
  createdAt DateTime   @default(now())
  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model SaleEvent {
  id           String         @id @default(cuid())
  leadId       String
  actorId      String
  saleValue    Decimal
  mrr          Decimal
  occurredAt   DateTime       @default(now())
  reversedAt   DateTime?
  reversedById String?
  lineItems    SaleLineItem[]
  lead         Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, occurredAt])
  @@index([occurredAt])
  @@index([reversedAt, occurredAt])
}

model ServiceCatalogItem {
  id           String             @id @default(cuid())
  name         String
  price        Decimal            @db.Decimal(12, 2)
  billingType  ServiceBillingType
  isActive     Boolean            @default(true)
  scope        String?            @db.Text
  deliverables String?            @db.Text
  restrictions String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  saleItems    SaleLineItem[]

  @@index([isActive, name])
}

model CompanyAnalysis {
  id                  String   @id @default(cuid())
  leadId              String
  leadVersion         Int
  evidenceFingerprint String
  promptVersion       String
  result              Json
  createdAt           DateTime @default(now())
  lead                Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, evidenceFingerprint])
  @@index([leadId, createdAt])
}

model MessagingMessage {
  id                String             @id @default(cuid())
  leadId            String
  leadVersion       Int
  createdById       String
  provider          String
  channel           Channel
  direction         MessagingDirection
  status            MessagingStatus    @default(DRAFT)
  idempotencyKey    String             @unique
  recipient         String
  providerMessageId String?
  content           String             @db.Text
  approvedById      String?
  approvedAt        DateTime?
  sentAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lead              Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([provider, providerMessageId])
  @@index([leadId, createdAt])
  @@index([status, createdAt])
}

model MessagingWebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  externalEventId String
  eventType       String
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  error           String?

  @@unique([provider, externalEventId])
  @@index([processedAt, receivedAt])
}

model ContactSuppression {
  id                String   @id @default(cuid())
  channel           Channel
  normalizedContact String
  reason            String
  createdAt         DateTime @default(now())
  createdById       String?

  @@unique([channel, normalizedContact])
  @@index([createdAt])
}

model SaleLineItem {
  id          String              @id @default(cuid())
  saleEventId String
  serviceId   String?
  serviceName String
  price       Decimal             @db.Decimal(12, 2)
  billingType ServiceBillingType
  saleEvent   SaleEvent           @relation(fields: [saleEventId], references: [id], onDelete: Cascade)
  service     ServiceCatalogItem? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([saleEventId])
  @@index([serviceId])
}

model CrmSettings {
  id                String   @id @default("team")
  followUpDelayDays Int      @default(2)
  updatedAt         DateTime @updatedAt
}

model FollowUp {
  id            String        @id @default(cuid())
  leadId        String
  dueDate       DateTime
  ownerId       String
  state         FollowUpState @default(PENDING)
  note          String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  completedAt   DateTime?
  completedById String?
  cancelledAt   DateTime?
  cancelledById String?
  returnStage   LeadStage?
  lead          Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([ownerId, dueDate])
  @@index([leadId, state, completedAt, id])
}

model CrmTask {
  id            String          @id @default(cuid())
  leadId        String
  title         String
  type          CrmTaskType
  priority      CrmTaskPriority @default(NORMAL)
  dueDate       DateTime
  assigneeId    String
  createdById   String
  updatedById   String
  state         CrmTaskState    @default(PENDING)
  completedAt   DateTime?
  completedById String?
  cancelledAt   DateTime?
  cancelledById String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  lead          Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([state, dueDate])
  @@index([assigneeId, state, dueDate])
  @@index([leadId, createdAt])
}

model Goal {
  id                       String         @id @default(cuid())
  ownerId                  String
  periodKind               GoalPeriodKind
  periodStart              DateTime
  periodEnd                DateTime
  approachesTarget         Int?
  interestsTarget          Int?
  meetingsTarget           Int?
  proposalsSentTarget      Int?
  salesTarget              Int?
  revenueTarget            Float?
  mrrTarget                Float?
  followUpsCompletedTarget Int?
  conversionRateTarget     Float?
  customGoals              Json           @default("[]")
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@unique([ownerId, periodKind, periodStart])
  @@index([periodStart])
}

model TeamGoalSettings {
  id              String   @id @default("team")
  monthlyStartDay Int      @default(1)
  updatedAt       DateTime @updatedAt
}

model DailyReport {
  id         String   @id @default(cuid())
  dayStart   DateTime @unique
  dayEnd     DateTime
  closedAt   DateTime
  closedById String
  snapshot   Json
}

model MetricImportBatch {
  id          String            @id @default(cuid())
  ownerId     String
  actorId     String
  fileName    String
  contentHash String
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime          @default(now())
  rows        MetricImportRow[]

  @@unique([ownerId, contentHash, periodStart, periodEnd])
  @@index([ownerId, periodStart, periodEnd])
  @@index([createdAt])
}

model MetricImportRow {
  id           String            @id @default(cuid())
  batchId      String
  metricKey    String?
  customGoalId String?
  label        String
  unit         String?
  value        Decimal           @db.Decimal(14, 4)
  batch        MetricImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([metricKey])
  @@index([customGoalId])
}

model MemberProfile {
  id            String            @id
  name          String
  email         String
  avatarUrl     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  credential    MemberCredential?
  crmSavedViews CrmSavedView[]
}

model CrmSavedView {
  id             String            @id @default(cuid())
  ownerId        String
  scope          CrmSavedViewScope
  name           String
  normalizedName String
  filters        Json
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  owner          MemberProfile     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, scope, normalizedName])
  @@index([ownerId, scope, updatedAt])
}

model MemberCredential {
  id           String        @id @default(cuid())
  memberId     String        @unique
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  member       MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model ResearchSearchSession {
  id        String   @id
  ownerId   String
  state     Json
  expiresAt DateTime
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, expiresAt])
}

model ResearchDismissal {
  id        String   @id @default(cuid())
  ownerId   String
  osmId     String
  createdAt DateTime @default(now())

  @@unique([ownerId, osmId])
  @@index([ownerId])
}

model ResearchCampaign {
  id                 String                      @id @default(cuid())
  ownerId            String
  idempotencyKey     String                      @unique
  requestFingerprint String
  name               String
  niche              String
  region             String
  city               String?
  criteria           Json
  checkpoint         Json
  maxCandidates      Int                         @default(20)
  maxAreas           Int                         @default(20)
  release            String?
  status             ResearchCampaignStatus      @default(QUEUED)
  checkpointVersion  Int                         @default(0)
  completedAreas     Int                         @default(0)
  candidateCount     Int                         @default(0)
  workflowRunId      String?                     @unique
  dispatchLeaseUntil DateTime?
  error              String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  candidates         ResearchCampaignCandidate[]

  @@index([ownerId, createdAt])
  @@index([status, updatedAt])
}

model ProspectCandidate {
  id                  String                      @id @default(cuid())
  source              String
  externalId          String
  name                String
  normalizedName      String
  identityFingerprint String
  phone               String?
  website             String?
  instagram           String?
  whatsapp            String?
  address             String?
  category            String?
  latitude            Float?
  longitude           Float?
  imageUrl            String?
  status              ProspectCandidateStatus     @default(NEW)
  leadId              String?                     @unique
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  lead                Lead?                       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  campaigns           ResearchCampaignCandidate[]
  evidence            ResearchEvidence[]

  @@unique([source, externalId])
  @@index([normalizedName, latitude, longitude])
  @@index([status, createdAt])
}

model ResearchCampaignCandidate {
  campaignId  String
  candidateId String
  firstSeenAt DateTime          @default(now())
  campaign    ResearchCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  candidate   ProspectCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@id([campaignId, candidateId])
  @@index([candidateId])
}

model ResearchEvidence {
  id               String            @id @default(cuid())
  candidateId      String
  field            String
  value            String?
  source           String
  sourceUrl        String            @default("")
  release          String?
  verified         Boolean           @default(false)
  extractorVersion String
  capturedAt       DateTime          @default(now())
  candidate        ProspectCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, field, source, sourceUrl])
  @@index([candidateId, field, capturedAt])
}

model AgentRun {
  id             String         @id @default(cuid())
  idempotencyKey String         @unique
  leadId         String
  createdById    String
  workflowRunId  String?        @unique
  status         AgentRunStatus @default(QUEUED)
  policyVersion  String
  leadVersion    Int
  inputSnapshot  Json
  result         Json?
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actions        AgentAction[]

  @@index([status, createdAt])
  @@index([leadId, createdAt])
}

model AgentAction {
  id            String            @id @default(cuid())
  runId         String
  leadId        String
  status        AgentActionStatus @default(PENDING)
  approvalToken String            @unique
  approvalHash  String
  leadVersion   Int
  title         String
  description   String
  taskType      CrmTaskType
  priority      CrmTaskPriority   @default(NORMAL)
  dueDate       DateTime
  approvedById  String?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  appliedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  run           AgentRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  lead          Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  outbox        AgentOutbox?

  @@unique([runId, leadVersion])
  @@index([status, createdAt])
  @@index([leadId, createdAt])
}

model AgentOutbox {
  id          String            @id @default(cuid())
  actionId    String            @unique
  payload     Json
  status      AgentOutboxStatus @default(PENDING)
  attempts    Int               @default(0)
  lastError   String?
  createdAt   DateTime          @default(now())
  deliveredAt DateTime?
  action      AgentAction       @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}
